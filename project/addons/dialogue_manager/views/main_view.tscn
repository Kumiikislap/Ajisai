text = "using MovieDataTest
# needs to be autoloaded to be used in using whatever that is called

~ start
do show_actor(Turdus)
Miao : a [do show_actor(Turdus)]
do hide_actor(Turdus)
Miao : aaa1
Miao : aaaaa2
Miao : aaaaa3
Miao : aaaaa4
Nathan: [[Hi|Hello|Howdy]], this is some dialogue. 
do show_actor(Turdus)
#do set_actor_position(Turdus, right)
Nathan: Here are some choices.
Turdus: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
- bro
	Miao: skip pls
do hide_actor(Turdus)
Turdus: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA.
- First one
	Nathan: You picked the first one.
- Second one
	Nathan: You picked the second one.
- Start again => start
Turdus: ha
Turdus: from GDE
do print(Turdus)
- End the conversation => END
Nathan: For more information see the online documentation.
=> END"
scroll_smooth = true
syntax_highlighter = SubResource("SyntaxHighlighter_faxki")

